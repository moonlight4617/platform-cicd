{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS",
          "semanticVersion": "1.90.0",
          "rules": [
            {
              "id": "java.lang.security.audit.sqli.jdbc-sqli",
              "name": "jdbc-sqli",
              "shortDescription": { "text": "SQL injection via string concatenation" },
              "defaultConfiguration": { "level": "error" },
              "properties": { "security-severity": "8.8", "tags": ["security"] }
            },
            {
              "id": "java.lang.best-practice.unused-variable",
              "name": "unused-variable",
              "shortDescription": { "text": "Unused local variable" },
              "defaultConfiguration": { "level": "note" },
              "properties": { "tags": ["best-practice"] }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "java.lang.security.audit.sqli.jdbc-sqli",
          "level": "error",
          "message": { "text": "Detected SQL statement built from user input" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/main/java/com/example/OrderRepository.java" },
                "region": { "startLine": 48 }
              }
            }
          ]
        },
        {
          "ruleId": "java.lang.best-practice.unused-variable",
          "level": "note",
          "message": { "text": "Unused variable: tmp" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/main/java/com/example/OrderService.java" },
                "region": { "startLine": 12 }
              }
            }
          ]
        }
      ]
    }
  ]
}
